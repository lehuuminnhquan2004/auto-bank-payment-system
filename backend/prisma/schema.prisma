// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum PaymentStatus {
  PENDING
  PAID
  EXPIRED
  FAILED
  CANCELLED
}

enum OrderStatus {
  PENDING
  PAID
  EXPIRED
  CANCELLED
}

enum PaymentMethod {
  BANK_TRANSFER
  BALANCE
}

enum BankTransferType {
  IN
  OUT
}

enum WebhookStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
  DUPLICATE
}

model User {
  id           BigInt   @id @default(autoincrement())
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  balance      BigInt   @default(0)
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  payments Payment[]
  orders   Order[]

  @@map("users")
}

model Payment {
  id          BigInt        @id @default(autoincrement())
  userId      BigInt        @map("user_id")
  orderId     BigInt?       @unique @map("order_id")
  paymentCode String        @unique @map("payment_code") @db.VarChar(32)
  amount      BigInt
  method      PaymentMethod @default(BANK_TRANSFER)
  status      PaymentStatus @default(PENDING)
  createdAt   DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.DateTime(3)
  expiredAt   DateTime?     @map("expired_at") @db.DateTime(3)
  paidAt      DateTime?     @map("paid_at") @db.DateTime(3)

  user  User   @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  order Order? @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  bankTransactions BankTransaction[]

  @@index([userId, createdAt])
  @@index([status, expiredAt])
  @@map("payments")
}

model Product {
  id        BigInt   @id @default(autoincrement())
  name      String   @db.VarChar(255)
  price     BigInt
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  orderItems OrderItem[]

  @@index([isActive])
  @@map("products")
}

model Order {
  id          BigInt      @id @default(autoincrement())
  userId      BigInt      @map("user_id")
  checkoutKey String      @map("checkout_key") @db.VarChar(36)
  requestHash String      @map("request_hash") @db.VarChar(64)
  status      OrderStatus @default(PENDING)
  totalAmount BigInt      @map("total_amount")
  createdAt   DateTime    @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.DateTime(3)
  paidAt      DateTime?   @map("paid_at") @db.DateTime(3)
  cancelledAt DateTime?   @map("cancelled_at") @db.DateTime(3)

  user    User        @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  items   OrderItem[]
  payment Payment?

  @@unique([userId, checkoutKey])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("orders")
}

model OrderItem {
  id                  BigInt @id @default(autoincrement())
  orderId             BigInt @map("order_id")
  productId           BigInt @map("product_id")
  productNameSnapshot String @map("product_name_snapshot") @db.VarChar(255)
  unitPriceSnapshot   BigInt @map("unit_price_snapshot")
  quantity            Int
  subtotal            BigInt

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([orderId, productId])
  @@index([productId])
  @@map("order_items")
}

model BankTransaction {
  id                    BigInt           @id @default(autoincrement())
  provider              String           @db.VarChar(50)
  providerTransactionId String           @map("provider_transaction_id") @db.VarChar(255)
  paymentId             BigInt?          @map("payment_id")
  bank                  String           @db.VarChar(100)
  transferType          BankTransferType @map("transfer_type")
  amount                BigInt
  content               String           @db.Text
  transactionTime       DateTime?        @map("transaction_time") @db.DateTime(3)
  rawPayload            Json             @map("raw_payload")
  createdAt             DateTime         @default(now()) @map("created_at") @db.DateTime(3)

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([provider, providerTransactionId])
  @@index([transactionTime])
  @@map("bank_transactions")
}

model WebhookLog {
  id                    BigInt        @id @default(autoincrement())
  provider              String        @db.VarChar(50)
  providerTransactionId String?       @map("provider_transaction_id") @db.VarChar(255)
  payload               Json
  status                WebhookStatus @default(RECEIVED)
  receivedAt            DateTime      @default(now()) @map("received_at") @db.DateTime(3)
  processedAt           DateTime?     @map("processed_at") @db.DateTime(3)
  errorMessage          String?       @map("error_message") @db.Text

  @@index([providerTransactionId])
  @@index([status, receivedAt])
  @@map("webhook_logs")
}
